ENV = 'production'

# If using Nginx to proxy backend API, change here to '/', see Docker deployment docs for Nginx config
# API address, note protocol, change https to http if ssl is not configured
VUE_APP_BASE_API  = 'https://eladmin.vip'
# If API is http format, wss needs to be changed to ws
VUE_APP_WS_API = 'wss://eladmin.vip'
